# ===== jaetech247.pro Environment Configuration =====

# Application
APP_NAME="JaeTech247 AutoTrading Platform"
APP_ENV=production
DEBUG=false
BASE_URL=https://jaetech247.pro

# Security - CHANGE THESE IN PRODUCTION
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32chars
AES_KEY=your-32-byte-aes-encryption-key!!  # Exactly 32 chars for AES-256
AES_IV=your-16-byte-iv!!                   # Exactly 16 chars

# Database
DATABASE_URL=sqlite+aiosqlite:///./jaetech247.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/jaetech247

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Trading
TOTAL_CHANNELS=35
PREMIUM_CHANNELS=6
CRYPTO_CHANNELS=24
STOCK_CHANNELS=5

# Grace Period (hours after expire_date before actual lockout)
GRACE_PERIOD_HOURS=24

# Account cleanup (days after registration without approval)
UNVERIFIED_ACCOUNT_TTL_DAYS=7

# Bithumb API Base URL
BITHUMB_API_URL=https://api.bithumb.com

# Korea Investment Securities (KIS) API
KIS_API_URL=https://openapi.koreainvestment.com:9443

# Admin credentials (initial setup)
ADMIN_ID=admin
ADMIN_PASSWORD=changeme_admin_2024!
